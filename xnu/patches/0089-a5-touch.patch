+	IOFixed nx = (IOFixed)(((int64_t)(x + offx) << 16) / fLogicalW);
+	IOFixed ny = (IOFixed)(((int64_t)(y + offy) << 16) / fLogicalH);
 	bool moved = down && (nx != fX[finger] || ny != fY[finger]);
 	if (was == down && !moved) {
