 {
+	/* canvas: x, y are already in the presented 1125x2436 display (A5: scaled panel) */
+	int maxx = canvas ? (int)fLogicalW - 1 : 1079, maxy = canvas ? (int)fLogicalH - 1 : 2399;
+	int offx = canvas ? 0 : fOffX, offy = canvas ? 0 : fOffY;
 	uint64_t now = mach_absolute_time();
 	IOHIDEvent *collection;
 	bool any = false;
@@ -458,22 +461,22 @@ SweetHIDTouch::touch(int finger, bool down, int x, int y)
 	if (finger < 0 || finger >= SWEET_TOUCH_FINGERS) {
 		return;
 	}
-	x = x < 0 ? 0 : (x > 1079 ? 1079 : x);
