+
+/* CMD25 of count sectors from the bounce buffer to lba. Caller holds the lock. */
+static int
+sd_write(uint64_t lba, uint32_t count)
+{
+	if (count > MAX_BLOCKS || lba + count > se.card_sectors || lba > UINT32_MAX ||
+	    !emmc_write_allowed(lba, count)) {
+		printf("SWEET EMMC: refusing write of %u sectors at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	return sd_dma(CMD25, MODE_WRITE_MULTI, BLKSZ_MULTI, (uint32_t)lba, count, true);
+}
+
+/* EXT_CSD (512 bytes) into the bounce buffer. */
+static int
+sd_ext_csd(void)
+{
+	return sd_dma(CMD8, MODE_READ_ONE, BLKSZ_ONE, 0, 1, false);
+}
+
+/* Flush the eMMC's volatile cache (if it is on). */
+static int
+sd_flush_cache(void)
+{
+	uint32_t r1 = 0;
+	if (!se.cache_on) {
+		return 0;
+	}
+	int error = sd_cmd(CMD6_R1B, 0x03200100u, &r1);       /* SWITCH write byte 32 FLUSH_CACHE = 1 */
+	if (!error) {
+		error = sd_wait_ready();
+	}
+	return error;
+}
