@@ -604,6 +778,102 @@ fnv1a(const uint8_t *p, uint32_t len)
 
 #define V11_HASH_128    0xa7f8c396u
 
+#define WTEST_OFFSET    (256ULL << 20)          /* far behind the test init at the start */
+#define WTEST_LEN       (256u << 10)
+
+static uint8_t wt_save[WTEST_LEN], wt_pat[WTEST_LEN], wt_back[WTEST_LEN];
+
+/*
+ * Write test, blackbox only: save 256 KiB at blackbox + 256 MiB, write a fresh
+ * pattern, read it back, write 1536 bytes at an unaligned offset (read-merge-
+ * write path), read back, restore the saved bytes, read back. Also checks that
+ * writes just outside the partition are refused without touching the card.
+ */
+static int
+sweet_emmc_write_test(void)
+{
+	int error = sweet_emmc_init();
+	if (error) {
+		printf("SWEET EMMC WTEST: init failed (%d)\n", error);
+		return error;
+	}
+	if (strcmp(se.part, "blackbox") != 0 || !se.writable || se.nsect * SECTOR < WTEST_OFFSET + WTEST_LEN) {
+		printf("SWEET EMMC WTEST: needs emmcroot=blackbox emmcrw=1 (part %s, %s)\n",
+		    se.part, se.writable ? "rw" : "ro");
+		return EPERM;
+	}
+	lck_mtx_lock(&sweet_emmc_lock);
+	uint64_t seed = mach_absolute_time() | 1;
+	for (uint32_t i = 0; i < WTEST_LEN; i += 8) {
+		seed ^= seed << 13; seed ^= seed >> 7; seed ^= seed << 17;
+		memcpy(wt_pat + i, &seed, 8);
+	}
+	const char *step = "save";
+	error = emmc_read_bytes(WTEST_OFFSET, WTEST_LEN, wt_save);
+	uint32_t h0 = fnv1a(wt_save, WTEST_LEN);
+	uint64_t t0 = us_now(), dt = 0;
+	if (!error) {
+		step = "write pattern";
+		error = emmc_write_bytes(WTEST_OFFSET, WTEST_LEN, wt_pat);
+		if (!error) {
+			step = "flush";
+			error = sd_flush_cache();
+		}
+		dt = us_now() - t0;
+	}
+	if (!error) {
+		step = "read pattern";
+		error = emmc_read_bytes(WTEST_OFFSET, WTEST_LEN, wt_back);
+		if (!error && memcmp(wt_back, wt_pat, WTEST_LEN) != 0) {
+			error = EILSEQ;
+		}
+	}
+	if (!error) {
+		printf("SWEET EMMC WTEST: 256 KiB written+flushed in %llu us, read back OK\n", dt);
+		step = "unaligned write";
+		static const char msg[] = "SWEET A5 unaligned write test ";
+		uint8_t odd[3 * SECTOR];
+		for (uint32_t i = 0; i < sizeof(odd); i++) {
+			odd[i] = (uint8_t)msg[i % (sizeof(msg) - 1)];
+		}
+		error = emmc_write_bytes(WTEST_OFFSET + 1000, sizeof(odd), odd);
+		if (!error) {
+			step = "unaligned read back";
+			error = emmc_read_bytes(WTEST_OFFSET, WTEST_LEN, wt_back);
+			memcpy(wt_pat + 1000, odd, sizeof(odd));
+			if (!error && memcmp(wt_back, wt_pat, WTEST_LEN) != 0) {
+				error = EILSEQ;
+			}
+		}
+	}
+	/* always try to restore once the original was saved */
+	int rerr = 0;
+	if (strcmp(step, "save") != 0) {
+		rerr = emmc_write_bytes(WTEST_OFFSET, WTEST_LEN, wt_save);
+		if (!rerr) {
+			rerr = sd_flush_cache();
+		}
+		if (!rerr) {
+			rerr = emmc_read_bytes(WTEST_OFFSET, WTEST_LEN, wt_back);
+		}
+		if (!rerr && memcmp(wt_back, wt_save, WTEST_LEN) != 0) {
+			rerr = EILSEQ;
+		}
+	}
+	/* bounds: one sector before and one after the partition must be refused */
+	int b1 = sd_write(se.first - 1, 1), b2 = sd_write(se.first + se.nsect, 1);
+	lck_mtx_unlock(&sweet_emmc_lock);
+	if (error) {
+		printf("SWEET EMMC WTEST: %s FAILED (%d) int 0x%08x r1 0x%08x\n", step, error, se.last_int, se.last_r1);
+	} else {
+		printf("SWEET EMMC WTEST: unaligned write (read-merge-write) OK\n");
+	}
+	printf("SWEET EMMC WTEST: original restored %s (%d), hash %08X\n", rerr ? "FAILED" : "OK", rerr, h0);
+	printf("SWEET EMMC WTEST: writes outside the partition refused: %s\n",
+	    (b1 == EPERM && b2 == EPERM) ? "yes" : "NO");
+	return error ? error : rerr ? rerr : (b1 == EPERM && b2 == EPERM) ? 0 : EIO;
+}
