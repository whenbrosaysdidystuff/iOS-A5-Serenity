+/* Write len bytes from src at byte offset off of the partition. Caller holds the lock. */
+static int
+emmc_write_bytes(uint64_t off, uint32_t len, const void *src)
+{
+	const uint8_t *in = src;
+	uint64_t part_bytes = se.nsect * SECTOR;
+	if (!se.writable) {
+		return EROFS;
+	}
+	if (off > part_bytes || len > part_bytes - off) {
+		return EINVAL;
+	}
+	for (uint32_t done = 0; done < len;) {
+		uint64_t pos = off + done;
+		uint32_t skip = (uint32_t)(pos % SECTOR);
+		uint32_t want = MIN(len - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + SECTOR - 1) / SECTOR;
+		uint64_t lba = se.first + pos / SECTOR;
+		int error = 0;
+		/* Partial sectors at either end: read, merge, write back. */
+		if (skip || ((skip + want) % SECTOR)) {
+			error = sd_read_retry(lba, blocks);
+		}
+		if (!error) {
+			memcpy((uint8_t *)se.dma + skip, in + done, want);
+			error = sd_write(lba, blocks);
+		}
+		if (error) {
+			return error;
+		}
+		done += want;
+	}
+	return 0;
+}
