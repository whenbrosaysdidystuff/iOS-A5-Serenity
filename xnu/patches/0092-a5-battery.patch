+/*
+ * Battery for SweetBattery (sweetbattery=2): SC2730 fuel gauge (PMIC 0xc00, Linux
+ * sc27xx_fuel_gauge.c), read-only. VOLTAGE 0xc20, CURRENT 0xc2c (0x2000 = 0 mA); nominal
+ * scale ~683 ADC/V (no eFuse calibration yet), current 4x that per A (probe V16 on the
+ * phone: +88 mA charging / -33 mA idle at ~4.1 V). Positive mA = charging.
+ */
+#define FGU_EN_REG      0x1808u
+#define FGU_VOLTAGE     0xc20u
+#define FGU_CURRENT     0xc2cu
+#define FGU_ADC_1V      683
+
+int sweet_a5_battery(unsigned *mv, int *ma);
+
+int
+sweet_a5_battery(unsigned *mv, int *ma)
+{
+	uint32_t en = 0, v = 0, c = 0;
+	if (adi == 0) {
+		return -1;
+	}
+	if (adi_read(FGU_EN_REG, &en) || !(en & (1u << 7)) ||
+	    adi_read(FGU_VOLTAGE, &v) || adi_read(FGU_CURRENT, &c)) {
+		return -1;
+	}
+	*mv = v * 1000u / FGU_ADC_1V;
+	*ma = ((int)c - 0x2000) * 1000 / (4 * FGU_ADC_1V);
+	return 0;
+}
