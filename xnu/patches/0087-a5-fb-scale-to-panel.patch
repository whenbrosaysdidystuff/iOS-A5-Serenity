+/* Black outside the scaled canvas (the console may have drawn there). */
+void
+AppleCLCD::clearBars(void)
+{
+	for (uint32_t y = 0; y < fHeight; y++) {
+		uint32_t *row = (uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+		if (y < fPadY || y >= fPadY + fScaledH) {
+			bzero(row, (size_t)fWidth * 4);
+		} else if (fPadX) {
+			bzero(row, (size_t)fPadX * 4);
+			bzero(row + fPadX + fScaledW, (size_t)(fWidth - fPadX - fScaledW) * 4);
+		}
+	}
+}
+
+/* a + (b - a) * f / 256 for each of the four 8-bit channels */
+static inline uint32_t
+lerp8888(uint32_t a, uint32_t b, uint32_t f)
+{
+	uint32_t g = 256 - f;
+	uint32_t rb = (((a & 0x00ff00ffu) * g + (b & 0x00ff00ffu) * f) >> 8) & 0x00ff00ffu;
+	uint32_t ag = (((a >> 8) & 0x00ff00ffu) * g + ((b >> 8) & 0x00ff00ffu) * f) & 0xff00ff00u;
+	return rb | ag;
+}
+
+/*
+ * Canvas rectangle (dx,dy,w,h), whose pixels come 1:1 from surface (sx,sy),
+ * onto the panel at scale num/den. Each panel pixel centre is mapped back to
+ * the canvas (16.8 fixed point) and sampled inside the source rectangle only.
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, uintptr_t src, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	const uint64_t num = fScaleNum, den = fScaleDen;
+	/* panel pixels whose centres fall inside the destination rectangle */
+	int64_t px0 = (int64_t)(((uint64_t)dx * num + den / 2) / den);
+	int64_t px1 = (int64_t)(((uint64_t)(dx + w) * num + den / 2) / den);
+	int64_t py0 = (int64_t)(((uint64_t)dy * num + den / 2) / den);
+	int64_t py1 = (int64_t)(((uint64_t)(dy + h) * num + den / 2) / den);
+	if (px1 > (int64_t)fScaledW) {
+		px1 = fScaledW;
+	}
+	if (py1 > (int64_t)fScaledH) {
+		py1 = fScaledH;
+	}
+	if (px0 >= px1 || py0 >= py1) {
+		return;
+	}
+	const uintptr_t base = src + s->offset;
+	const uint32_t bpr = s->bytesPerRow;
+	const bool smooth = fScaleMode == 2;
+	/* source x (<< 8) for a canvas-relative panel coordinate p: ((p + 0.5) * den / num - 0.5) */
+#define SRC_FIX(p, origin, lim) ({                                                       \
+	int64_t _v = (((int64_t)(p) * 2 + 1) * (int64_t)den * 256) / (2 * (int64_t)num) - 128;  \
+	_v -= (int64_t)(origin) << 8;                                                       \
+	if (_v < 0) _v = 0;                                                                 \
+	if (_v > ((int64_t)(lim) - 1) << 8) _v = ((int64_t)(lim) - 1) << 8;                 \
+	_v; })
+	for (int64_t px = px0; px < px1; px++) {
+		fColX[px] = (uint32_t)SRC_FIX(px, dx, w);
+	}
+	for (int64_t py = py0; py < py1; py++) {
+		int64_t fy = SRC_FIX(py, dy, h);
+		int32_t y0 = (int32_t)(fy >> 8), wy = (int32_t)(fy & 0xff);
+		int32_t y1 = y0 + 1 < h ? y0 + 1 : y0;
+		const uint32_t *r0 = (const uint32_t *)(base + (uint64_t)(sy + y0) * bpr) + sx;
+		const uint32_t *r1 = (const uint32_t *)(base + (uint64_t)(sy + y1) * bpr) + sx;
+		uint32_t *out = (uint32_t *)(fPixels + (uint64_t)(fPadY + py) * fRowBytes) + fPadX;
+		if (!smooth) {
+			const uint32_t *r = wy < 128 ? r0 : r1;
+			for (int64_t px = px0; px < px1; px++) {
+				uint32_t c = fColX[px];
+				out[px] = r[(c >> 8) + ((c & 0xff) >= 128 && (int32_t)(c >> 8) + 1 < w)];
+			}
+			continue;
+		}
+		for (int64_t px = px0; px < px1; px++) {
+			uint32_t c = fColX[px];
+			uint32_t x0 = c >> 8, wx = c & 0xff;
+			uint32_t x1 = (int32_t)x0 + 1 < w ? x0 + 1 : x0;
+			uint32_t top = lerp8888(r0[x0], r0[x1], wx);
+			uint32_t bot = lerp8888(r1[x0], r1[x1], wx);
+			out[px] = lerp8888(top, bot, (uint32_t)wy);
+		}
+	}
+#undef SRC_FIX
+}
+
+/*
+ * Panel point -> presented canvas point (for touch drivers on scaled panels).
+ * Returns false outside the scaled canvas.
+ */
+
+extern "C" bool sweet_fb_panel_to_canvas(uint32_t px, uint32_t py, uint32_t *cx, uint32_t *cy);
+
+extern "C" bool
+sweet_fb_panel_to_canvas(uint32_t px, uint32_t py, uint32_t *cx, uint32_t *cy)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (fb == NULL || !fb->fScaleMode) {
+		*cx = px;
+		*cy = py;
+		return true;
+	}
+	if (px < fb->fPadX || py < fb->fPadY || px >= fb->fPadX + fb->fScaledW || py >= fb->fPadY + fb->fScaledH) {
+		return false;
+	}
+	*cx = (uint32_t)((uint64_t)(px - fb->fPadX) * fb->fScaleDen / fb->fScaleNum);
+	*cy = (uint32_t)((uint64_t)(py - fb->fPadY) * fb->fScaleDen / fb->fScaleNum);
+	return true;
+}
