diff --git a/bsd/dev/sweet_a5_keys.c b/bsd/dev/sweet_a5_keys.c
new file mode 100644
index 0000000..a134b9a
--- /dev/null
+++ b/bsd/dev/sweet_a5_keys.c
@@ -0,0 +1,220 @@
+/*
+ * Redmi A5 (serenity, UMS9230 + SC2730 PMIC) buttons, polled every 20 ms and
+ * fed to the HID button service (iokit/Kernel/arm/hid/SweetHID.cpp) through
+ * sweet_hid_key(0 power, 1 volume up, 2 volume down, down).
+ *
+ * From the phone's own device tree (dtbo, gpio-keys):
+ *   volume down  ap_gpio 124, active low   ap_gpio = /soc/aon/gpio@641b0000
+ *   volume up    pmic_eic 4,  active high  pmic_eic = SC2730 gpio@280 (ADI)
+ *   power        pmic_eic 1,  active low
+ * Registers as Linux gpio-sprd.c (16 GPIOs per 0x80 bank: DATA 0x0, DMSK 0x4,
+ * DIR 0x8, INEN 0x28) and gpio-pmic-eic-sprd.c (DATA 0x0, DMSK 0x4). Reading a
+ * line needs its DMSK bit (and for AP GPIO: DIR clear, INEN set); those bits
+ * are set for these three lines only, as gpio_request + direction_input do.
+ *
+ * The PMIC is reached through the ADI bus exactly as the shim's watchdog stop
+ * (shim-a5/pmic_wdt.c, proven on the phone): every read checks the echoed
+ * address and nothing is written unless all reads echoed correctly.
+ *
+ * Boot-arg a5keys=0 disables it. State changes are logged as
+ * "SWEET A5 KEYS: <key> down|up" (console or persistent log).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+void sweet_a5_keys_init(void);
+
+#define ADI_PA          0x64200000u
+#define ADI_MAP_SIZE    0x30000u
+#define ADI_SLAVE_OFF   0x20000u
+#define ADI_RD_CMD      0x28
+#define ADI_RD_DATA     0x2c
+#define ADI_FIFO_STS    0x30
+#define FIFO_FULL       (1u << 11)
+#define FIFO_EMPTY      (1u << 10)
+
+#define PEIC            0x280u          /* SC2730 EIC (gpio@280) */
+#define PEIC_DATA       (PEIC + 0x00)
+#define PEIC_DMSK       (PEIC + 0x04)
+#define PEIC_POWER      1u              /* active low */
+#define PEIC_VOLUP      4u              /* active high */
+
+#define GPIO_PA         0x641b0000u
+#define GPIO_VOLDN      124u            /* active low */
+#define GPIO_BANK       (GPIO_VOLDN / 16u)
+#define GPIO_BIT        (1u << (GPIO_VOLDN % 16u))
+#define GPIO_DATA       0x00
+#define GPIO_DMSK       0x04
+#define GPIO_DIR        0x08
+#define GPIO_INEN       0x28
+
+static vm_offset_t adi, gpio_bank;
+static bool keys_started, peic_ok, gpio_ok;
+static int keys_chan;
+
+static inline uint32_t
+rd32(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr32(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+/* 0 ok; 1 timeout; 2 the echoed address did not match */
+static int
+adi_read(uint32_t reg, uint32_t *val)
+{
+	uint32_t pa = ADI_PA + ADI_SLAVE_OFF + reg;
+	wr32(adi + ADI_RD_CMD, pa);
+	for (int i = 0; i < 100000; i++) {
+		uint32_t d = rd32(adi + ADI_RD_DATA);
+		if (!(d & 0x80000000u)) {
+			*val = d & 0xffffu;
+			return (((d >> 16) & 0x7fffu) == ((pa & 0x1fffcu) >> 2)) ? 0 : 2;
+		}
+	}
+	return 1;
+}
+
+static int
+adi_write(uint32_t reg, uint32_t v)
+{
+	int i;
+	for (i = 0; i < 100000 && (rd32(adi + ADI_FIFO_STS) & FIFO_FULL); i++) {
+	}
+	if (i == 100000) {
+		return 1;
+	}
+	wr32(adi + ADI_SLAVE_OFF + reg, v & 0xffffu);
+	for (i = 0; i < 100000 && !(rd32(adi + ADI_FIFO_STS) & FIFO_EMPTY); i++) {
+	}
+	return i == 100000 ? 2 : 0;
+}
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static const char *const key_name[3] = { "power", "volume-up", "volume-down" };
+
+static void
+keys_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int state[3] = { 0, 0, 0 }, cand[3] = { 0, 0, 0 }, same[3] = { 0, 0, 0 };
+	unsigned errors = 0;
+
+	for (;;) {
+		int now[3] = { -1, -1, -1 };
+		uint32_t d = 0;
+		if (peic_ok) {
+			int rc = adi_read(PEIC_DATA, &d);
+			if (rc == 0) {
+				now[0] = !(d & (1u << PEIC_POWER));
+				now[1] = !!(d & (1u << PEIC_VOLUP));
+			} else if ((errors++ % 500u) == 0) {
+				printf("SWEET A5 KEYS: PMIC EIC read error %d\n", rc);
+			}
+		}
+		if (gpio_ok) {
+			now[2] = !(rd32(gpio_bank + GPIO_DATA) & GPIO_BIT);
+		}
+		/* two equal samples (40 ms) before a change counts */
+		for (int k = 0; k < 3; k++) {
+			if (now[k] < 0) {
+				continue;
+			}
+			if (now[k] != cand[k]) {
+				cand[k] = now[k];
+				same[k] = 0;
+			} else if (++same[k] >= 1 && cand[k] != state[k]) {
+				state[k] = cand[k];
+				printf("SWEET A5 KEYS: %s %s\n", key_name[k], state[k] ? "down" : "up");
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		keys_wait();
+	}
+}
+
+void
+sweet_a5_keys_init(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	PE_parse_boot_argn("a5keys", &on, sizeof(on));
+	if (!on) {
+		printf("SWEET A5 KEYS: disabled (a5keys=0)\n");
+		return;
+	}
+	adi = ml_io_map(ADI_PA, ADI_MAP_SIZE);
+	gpio_bank = ml_io_map(GPIO_PA, 0x1000) + GPIO_BANK * 0x80u;
+
+	/* PMIC EIC: enable reading of lines 1 and 4 (data mask), only if ADI echoes check out */
+	uint32_t data = 0, dmsk = 0;
+	int rc = adi_read(PEIC_DATA, &data) | adi_read(PEIC_DMSK, &dmsk);
+	uint32_t want = (1u << PEIC_POWER) | (1u << PEIC_VOLUP);
+	int wrc = 0;
+	if (rc == 0 && (dmsk & want) != want) {
+		wrc = adi_write(PEIC_DMSK, dmsk | want);
+		uint32_t back = 0;
+		rc = adi_read(PEIC_DMSK, &back);
+		if (rc == 0 && (back & want) != want) {
+			rc = 3;
+		}
+		dmsk = back;
+	}
+	peic_ok = (rc == 0 && wrc == 0);
+	printf("SWEET A5 KEYS: PMIC EIC data 0x%04x dmsk 0x%04x rc %d/%d -> power+volume-up %s\n",
+	    data, dmsk, rc, wrc, peic_ok ? "on" : "OFF");
+
+	/* AP GPIO 124: data mask on, input (DIR clear, INEN set) */
+	uint32_t g_data = rd32(gpio_bank + GPIO_DATA), g_dmsk = rd32(gpio_bank + GPIO_DMSK);
+	uint32_t g_dir = rd32(gpio_bank + GPIO_DIR), g_inen = rd32(gpio_bank + GPIO_INEN);
+	printf("SWEET A5 KEYS: GPIO bank %u data 0x%04x dmsk 0x%04x dir 0x%04x inen 0x%04x (bit 0x%04x)\n",
+	    GPIO_BANK, g_data & 0xffff, g_dmsk & 0xffff, g_dir & 0xffff, g_inen & 0xffff, GPIO_BIT);
+	if (g_dir & GPIO_BIT) {
+		printf("SWEET A5 KEYS: GPIO %u is an output - volume-down left alone\n", GPIO_VOLDN);
+	} else {
+		if (!(g_dmsk & GPIO_BIT)) {
+			wr32(gpio_bank + GPIO_DMSK, g_dmsk | GPIO_BIT);
+		}
+		if (!(g_inen & GPIO_BIT)) {
+			wr32(gpio_bank + GPIO_INEN, g_inen | GPIO_BIT);
+		}
+		gpio_ok = (rd32(gpio_bank + GPIO_DMSK) & GPIO_BIT) && (rd32(gpio_bank + GPIO_INEN) & GPIO_BIT);
+		printf("SWEET A5 KEYS: volume-down %s, level %u\n", gpio_ok ? "on" : "OFF",
+		    !!(rd32(gpio_bank + GPIO_DATA) & GPIO_BIT));
+	}
+
+	if (!peic_ok && !gpio_ok) {
+		return;
+	}
+	if (kernel_thread_start(keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET A5 KEYS: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
