diff --git a/bsd/dev/sweet_a5_keys.c b/bsd/dev/sweet_a5_keys.c
index a134b9a..c900a67 100644
--- a/bsd/dev/sweet_a5_keys.c
+++ b/bsd/dev/sweet_a5_keys.c
@@ -18,6 +18,11 @@
  *
  * Boot-arg a5keys=0 disables it. State changes are logged as
  * "SWEET A5 KEYS: <key> down|up" (console or persistent log).
+ *
+ * Also the wall clock: the SC2730 RTC (PMIC 0x200, Linux rtc-sc27xx.c: SEC/MIN/HOUR
+ * counters 0x0/0x4/0x8, DAY counter 0xc = days since 1970-01-01, UTC as Android keeps
+ * it) is read once, read-only, and the kernel calendar set from it before launchd
+ * runs. Boot-arg a5rtc=0 disables it.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -56,6 +61,14 @@ void sweet_a5_keys_init(void);
 #define GPIO_DIR        0x08
 #define GPIO_INEN       0x28
 
+#define RTC             0x200u
+#define RTC_SEC         (RTC + 0x0)
+#define RTC_MIN         (RTC + 0x4)
+#define RTC_HOUR        (RTC + 0x8)
+#define RTC_DAY         (RTC + 0xc)
+#define RTC_2024        1704067200ull   /* sanity window for the value read */
+#define RTC_2100        4102444800ull
+
 static vm_offset_t adi, gpio_bank;
 static bool keys_started, peic_ok, gpio_ok;
 static int keys_chan;
@@ -153,6 +166,45 @@ keys_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 }
 
+static int
+rtc_read(uint64_t *secs)
+{
+	uint32_t s = 0, m = 0, h = 0, d = 0;
+	int rc = adi_read(RTC_SEC, &s) | adi_read(RTC_MIN, &m) | adi_read(RTC_HOUR, &h) | adi_read(RTC_DAY, &d);
+	if (rc) {
+		return rc;
+	}
+	*secs = (((uint64_t)(d & 0xffff) * 24 + (h & 0x1f)) * 60 + (m & 0x3f)) * 60 + (s & 0x3f);
+	return 0;
+}
+
+/* Kernel wall clock from the PMIC RTC (read twice: a counter may roll over mid-read). */
+static void
+rtc_sync(void)
+{
+	uint32_t on = 1;
+	uint64_t a = 0, b = 0;
+	PE_parse_boot_argn("a5rtc", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	for (int i = 0; i < 3; i++) {
+		if (rtc_read(&a) || rtc_read(&b)) {
+			printf("SWEET A5 RTC: read error\n");
+			return;
+		}
+		if (a == b) {
+			break;
+		}
+	}
+	if (a != b || a < RTC_2024 || a > RTC_2100) {
+		printf("SWEET A5 RTC: implausible value %llu (%llu), clock not set\n", a, b);
+		return;
+	}
+	clock_set_calendar_microtime((clock_sec_t)a, 0);
+	printf("SWEET A5 RTC: %llu s since 1970 (UTC), calendar set\n", a);
+}
+
 void
 sweet_a5_keys_init(void)
 {
@@ -170,6 +222,7 @@ sweet_a5_keys_init(void)
 	}
 	adi = ml_io_map(ADI_PA, ADI_MAP_SIZE);
 	gpio_bank = ml_io_map(GPIO_PA, 0x1000) + GPIO_BANK * 0x80u;
+	rtc_sync();
 
 	/* PMIC EIC: enable reading of lines 1 and 4 (data mask), only if ADI echoes check out */
 	uint32_t data = 0, dmsk = 0;
