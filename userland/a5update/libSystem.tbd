               _opendir, _pread, _pwrite, _read, _readdir, _rename, _rmdir, _sleep, _snprintf, _stat,
               _strcmp, _strerror, _strlcpy, _strlen, _strncmp, _strrchr, _symlink, _sync, _sysctl,
               _unlink, _vsnprintf, _write, dyld_stub_binder ]
...
